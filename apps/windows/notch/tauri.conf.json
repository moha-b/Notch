{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch Preview",
  "version": "0.0.0",
  "identifier": "io.github.moha-b.notch.preview",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/notch-hook.exe": "notch-hook.exe",
      "../LICENSE": "LICENSE.txt",
      "glyphs/NOTICE.md": "licenses/provider-marks.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
